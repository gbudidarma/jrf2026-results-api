{
  "openapi": "3.0.0",
  "info": {
    "title": "Jakarta Running Festival (JRF) Race Results API",
    "description": "Official race results and split timings dataset for the Jakarta Running Festival (Day 1 & Day 2), covering the Hydroplus Marathon (42.2K), myBCA Jakarta Half Marathon (21.1K), Le Minerale 10K, and Samsung Galaxy 5K.",
    "version": "1.0.0",
    "contact": {
      "name": "JRF Results API Support"
    }
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/gbudidarma/jrf2026-results-api/main",
      "description": "GitHub Raw Static JSON Server"
    }
  ],
  "tags": [
    {
      "name": "Events",
      "description": "Race events metadata and participant counts"
    },
    {
      "name": "Results",
      "description": "Event race results and split times"
    }
  ],
  "paths": {
    "/events.json": {
      "get": {
        "operationId": "listEvents",
        "tags": [
          "Events"
        ],
        "summary": "List all race events and participant counts",
        "description": "Returns metadata and total participant counts for all 4 Jakarta Running Festival race events.",
        "responses": {
          "200": {
            "description": "List of race events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competition": {
                      "type": "string",
                      "example": "Jakarta Running Festival"
                    },
                    "cid": {
                      "type": "integer",
                      "example": 19723
                    },
                    "total_events": {
                      "type": "integer",
                      "example": 4
                    },
                    "total_participants": {
                      "type": "integer",
                      "example": 36306
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventSummary"
                      }
                    }
                  }
                },
                "example": {
                  "competition": "Jakarta Running Festival",
                  "cid": 19723,
                  "total_events": 4,
                  "total_participants": 36306,
                  "events": [
                    {
                      "event_slug": "mybca_jakarta_half_marathon",
                      "event_name": "myBCA Jakarta Half Marathon",
                      "race_day": "Day 1",
                      "distance_km": 21.1,
                      "total_participants": 14684,
                      "finishers_count": 12684,
                      "split_checkpoints": [
                        "KM 5",
                        "KM 10",
                        "KM 15",
                        "KM 20",
                        "FINISH"
                      ]
                    },
                    {
                      "event_slug": "samsung_galaxy_5k",
                      "event_name": "Samsung Galaxy 5K",
                      "race_day": "Day 1",
                      "distance_km": 5.0,
                      "total_participants": 4761,
                      "finishers_count": 4048,
                      "split_checkpoints": [
                        "KM 3.4",
                        "FINISH"
                      ]
                    },
                    {
                      "event_slug": "hydroplus_marathon",
                      "event_name": "Hydroplus Marathon",
                      "race_day": "Day 2",
                      "distance_km": 42.195,
                      "total_participants": 4420,
                      "finishers_count": 2637,
                      "split_checkpoints": [
                        "KM 5",
                        "KM 10",
                        "KM 15",
                        "KM 20",
                        "KM 21.1",
                        "KM 25",
                        "KM 30",
                        "KM 35",
                        "KM 40",
                        "FINISH"
                      ]
                    },
                    {
                      "event_slug": "le_minerale_10k",
                      "event_name": "Le Minerale 10K",
                      "race_day": "Day 2",
                      "distance_km": 10.0,
                      "total_participants": 12441,
                      "finishers_count": 11233,
                      "split_checkpoints": [
                        "KM 3.9",
                        "KM 8.8",
                        "FINISH"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/{event_slug}_results.json": {
      "get": {
        "operationId": "getEventResultsBySlug",
        "tags": [
          "Results"
        ],
        "summary": "Get results by event slug",
        "description": "Fetches the complete results dataset for the selected event slug.",
        "parameters": [
          {
            "name": "event_slug",
            "in": "path",
            "required": true,
            "description": "Event slug identifier",
            "schema": {
              "type": "string",
              "enum": [
                "mybca_jakarta_half_marathon",
                "samsung_galaxy_5k",
                "hydroplus_marathon",
                "le_minerale_10k"
              ],
              "default": "hydroplus_marathon"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event results dataset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDatasetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/hydroplus_marathon_results.json": {
      "get": {
        "operationId": "getHydroplusMarathonResults",
        "tags": [
          "Results"
        ],
        "summary": "Get Hydroplus Marathon (42.2K) results",
        "description": "Returns all 4,420 participant results and split times for the Day 2 Hydroplus Marathon.",
        "responses": {
          "200": {
            "description": "Hydroplus Marathon results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDatasetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/le_minerale_10k_results.json": {
      "get": {
        "operationId": "getLeMinerale10KResults",
        "tags": [
          "Results"
        ],
        "summary": "Get Le Minerale 10K results",
        "description": "Returns all 12,441 participant results and split times for the Day 2 Le Minerale 10K.",
        "responses": {
          "200": {
            "description": "Le Minerale 10K results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDatasetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mybca_jakarta_half_marathon_results.json": {
      "get": {
        "operationId": "getMyBcaHalfMarathonResults",
        "tags": [
          "Results"
        ],
        "summary": "Get myBCA Jakarta Half Marathon (21.1K) results",
        "description": "Returns all 14,684 participant results and split times for the Day 1 myBCA Jakarta Half Marathon.",
        "responses": {
          "200": {
            "description": "myBCA Jakarta Half Marathon results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDatasetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/samsung_galaxy_5k_results.json": {
      "get": {
        "operationId": "getSamsungGalaxy5KResults",
        "tags": [
          "Results"
        ],
        "summary": "Get Samsung Galaxy 5K results",
        "description": "Returns all 4,761 participant results and split times for the Day 1 Samsung Galaxy 5K.",
        "responses": {
          "200": {
            "description": "Samsung Galaxy 5K results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDatasetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jrf_all_results.json": {
      "get": {
        "operationId": "getAllJrfResults",
        "tags": [
          "Results"
        ],
        "summary": "Get all 36,306 results across all 4 events",
        "description": "Returns the complete combined dataset for all 4 Jakarta Running Festival events.",
        "responses": {
          "200": {
            "description": "Combined results dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "competition": {
                      "type": "string",
                      "example": "Jakarta Running Festival"
                    },
                    "cid": {
                      "type": "integer",
                      "example": 19723
                    },
                    "total_events": {
                      "type": "integer",
                      "example": 4
                    },
                    "total_participants": {
                      "type": "integer",
                      "example": 36306
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventSummary"
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RunnerResult"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventSummary": {
        "type": "object",
        "required": [
          "event_slug",
          "event_name",
          "race_day",
          "distance_km",
          "total_participants",
          "finishers_count",
          "split_checkpoints"
        ],
        "properties": {
          "event_slug": {
            "type": "string",
            "example": "hydroplus_marathon"
          },
          "event_name": {
            "type": "string",
            "example": "Hydroplus Marathon"
          },
          "race_day": {
            "type": "string",
            "example": "Day 2"
          },
          "distance_km": {
            "type": "number",
            "format": "float",
            "example": 42.195
          },
          "total_participants": {
            "type": "integer",
            "example": 4420
          },
          "finishers_count": {
            "type": "integer",
            "example": 2637
          },
          "split_checkpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "KM 5",
              "KM 10",
              "KM 15",
              "KM 20",
              "KM 21.1",
              "KM 25",
              "KM 30",
              "KM 35",
              "KM 40",
              "FINISH"
            ]
          }
        }
      },
      "RunnerResult": {
        "type": "object",
        "required": [
          "event_slug",
          "event_name",
          "race_day",
          "status",
          "bib_no",
          "name",
          "splits"
        ],
        "properties": {
          "event_slug": {
            "type": "string",
            "example": "hydroplus_marathon"
          },
          "event_name": {
            "type": "string",
            "example": "Hydroplus Marathon"
          },
          "race_day": {
            "type": "string",
            "example": "Day 2"
          },
          "position": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "FINISHED",
              "DNS",
              "DNF",
              "CUT",
              "DQ",
              "DSQ",
              "QRY",
              "UNKNOWN"
            ],
            "example": "FINISHED"
          },
          "bib_no": {
            "type": "string",
            "example": "A14328"
          },
          "name": {
            "type": "string",
            "example": "KIPRONO KOECH"
          },
          "time": {
            "type": "string",
            "nullable": true,
            "example": "02:15:41"
          },
          "bruto_time": {
            "type": "string",
            "nullable": true,
            "example": "02:15:41"
          },
          "netto_time": {
            "type": "string",
            "nullable": true,
            "example": "02:15:37"
          },
          "category": {
            "type": "string",
            "nullable": true,
            "example": "TOP 3 OPEN"
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "example": "Male"
          },
          "country": {
            "type": "string",
            "nullable": true,
            "example": "Kenya"
          },
          "splits": {
            "type": "object",
            "properties": {
              "KM 3.4": {
                "type": "string",
                "nullable": true
              },
              "KM 3.9": {
                "type": "string",
                "nullable": true
              },
              "KM 5": {
                "type": "string",
                "nullable": true
              },
              "KM 8.8": {
                "type": "string",
                "nullable": true
              },
              "KM 10": {
                "type": "string",
                "nullable": true
              },
              "KM 15": {
                "type": "string",
                "nullable": true
              },
              "KM 20": {
                "type": "string",
                "nullable": true
              },
              "KM 21.1": {
                "type": "string",
                "nullable": true
              },
              "KM 25": {
                "type": "string",
                "nullable": true
              },
              "KM 30": {
                "type": "string",
                "nullable": true
              },
              "KM 35": {
                "type": "string",
                "nullable": true
              },
              "KM 40": {
                "type": "string",
                "nullable": true
              },
              "FINISH": {
                "type": "string",
                "nullable": true
              }
            },
            "example": {
              "KM 5": "15:41",
              "KM 10": "15:30",
              "KM 15": "16:04",
              "KM 20": "15:52",
              "KM 21.1": "3:27",
              "KM 25": "12:31",
              "KM 30": "16:16",
              "KM 35": "16:24",
              "KM 40": "16:43",
              "FINISH": "7:09"
            }
          }
        }
      },
      "EventDatasetResponse": {
        "type": "object",
        "required": [
          "metadata",
          "results"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/EventSummary"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunnerResult"
            }
          }
        }
      }
    }
  }
}